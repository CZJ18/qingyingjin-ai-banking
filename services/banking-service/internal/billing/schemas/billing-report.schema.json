            "maximum": 9223372036854775807
          },
          "transaction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "required": [
          "category",
          "expense_minor",
          "transaction_ids"
        ],
        "additionalProperties": false
      }
    },
