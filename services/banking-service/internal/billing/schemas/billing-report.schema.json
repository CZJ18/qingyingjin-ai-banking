  "properties": {
    "report_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "tool": {
      "enum": [
        "get_transactions",
        "get_account_summary",
        "analyze_spending",
        "compare_budget",
        "detect_anomalies",
        "generate_billing_report"
      ]
    },
    "analysis_period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "timezone": {
          "enum": [
            "UTC",
            "Asia/Shanghai"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "timezone"
      ],
      "additionalProperties": false
    },
    "currency": {
      "const": "CNY"
    },
    "total_income": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
