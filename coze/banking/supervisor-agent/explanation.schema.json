{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "agent_type",
    "explanation",
    "evidence_ids"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_type": {
      "type": "string",
      "enum": [
        "billing",
        "subscription",
        "savings",
        "lifestyle"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
