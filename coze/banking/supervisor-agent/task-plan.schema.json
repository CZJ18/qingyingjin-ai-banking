{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "agent_type",
          "tool",
          "parameters",
          "dependencies",
          "priority",
          "execution_mode"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "agent_type": {
            "type": "string",
            "enum": [
              "supervisor",
              "billing",
              "subscription",
              "savings",
              "lifestyle"
            ]
          },
          "tool": {
            "type": "string",
            "enum": [
              "get_transactions",
              "get_account_summary",
              "analyze_spending",
              "compare_budget",
              "detect_anomalies",
              "generate_billing_report",
              "detect_subscriptions",
              "get_subscription_details",
              "analyze_subscription_cost",
              "suggest_subscription_actions",
              "get_subscription_status",
              "get_financial_plan",
              "compare_financial_plans",
              "replan_financial_plan",
              "create_cancel_intent",
              "request_confirmation",
              "require_gateway",
              "get_lifestyle_goal",
              "get_lifestyle_plan",
              "compile_lifestyle_plan"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "read_only",
              "advice",
              "intent",
              "user_confirmation"
            ]
          },
          "skill_id": {
            "type": "string",
            "enum": [
              "task_planning",
              "billing_analysis",
              "subscription_analysis",
              "savings_planning",
              "operation_preparation",
              "lifestyle_planning"
            ]
          },
          "skill_version": {
            "type": "integer",
            "const": 1
          }
        },
        "dependentRequired": {
          "skill_id": [
            "skill_version"
          ],
          "skill_version": [
            "skill_id"
          ]
        },
        "allOf": [
          {
            "if": {
              "required": [
                "skill_id"
              ],
              "properties": {
                "skill_id": {
                  "const": "task_planning"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "enum": [
                    "supervisor"
                  ]
                },
                "tool": {
                  "enum": [
                    "request_confirmation"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "skill_id"
              ],
              "properties": {
                "skill_id": {
                  "const": "billing_analysis"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "enum": [
                    "billing"
                  ]
                },
                "tool": {
                  "enum": [
                    "get_transactions",
                    "get_account_summary",
                    "analyze_spending",
                    "compare_budget",
                    "detect_anomalies",
                    "generate_billing_report"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "skill_id"
              ],
              "properties": {
                "skill_id": {
                  "const": "subscription_analysis"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "enum": [
                    "subscription"
                  ]
                },
                "tool": {
                  "enum": [
                    "detect_subscriptions",
                    "get_subscription_details",
                    "analyze_subscription_cost",
                    "suggest_subscription_actions",
                    "get_subscription_status"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "skill_id"
              ],
              "properties": {
                "skill_id": {
                  "const": "savings_planning"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "enum": [
                    "savings"
                  ]
                },
                "tool": {
                  "enum": [
                    "get_financial_plan",
                    "compare_financial_plans",
                    "replan_financial_plan"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "skill_id"
              ],
              "properties": {
                "skill_id": {
                  "const": "operation_preparation"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "enum": [
                    "subscription",
                    "supervisor"
                  ]
                },
                "tool": {
                  "enum": [
                    "create_cancel_intent",
                    "require_gateway"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "skill_id"
              ],
              "properties": {
                "skill_id": {
                  "const": "lifestyle_planning"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "const": "lifestyle"
                },
                "tool": {
                  "enum": [
                    "get_lifestyle_goal",
                    "get_lifestyle_plan",
                    "compile_lifestyle_plan"
                  ]
                },
                "execution_mode": {
                  "enum": [
                    "read_only",
                    "advice"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "const": "get_lifestyle_goal"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "const": "lifestyle"
                },
                "execution_mode": {
                  "const": "read_only"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "const": "get_lifestyle_plan"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "const": "lifestyle"
                },
                "execution_mode": {
                  "const": "read_only"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "const": "compile_lifestyle_plan"
                }
              }
            },
            "then": {
              "properties": {
                "agent_type": {
                  "const": "lifestyle"
                },
                "execution_mode": {
                  "const": "advice"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "enum": [
                    "get_transactions",
                    "get_account_summary",
                    "analyze_spending",
                    "compare_budget",
                    "detect_anomalies",
                    "generate_billing_report"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "timezone": {
                      "enum": [
                        "UTC",
                        "Asia/Shanghai"
                      ]
                    },
                    "account_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "offset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "tool"
              ],
              "properties": {
                "tool": {
                  "enum": [
                    "get_financial_plan",
                    "compare_financial_plans",
                    "replan_financial_plan"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "plan_id"
                  ],
                  "properties": {
                    "plan_id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
