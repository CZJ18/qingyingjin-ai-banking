# Browser/static runtime receives no secrets. Keep backend credentials backend-only.
BANKING_WEB_IMAGE=qingrongjin-banking-web:p6
BANKING_WEB_PORT=8088
# Override only with a trusted registry when Docker Hub is unreachable.
BANKING_WEB_NODE_IMAGE=node:22-alpine
BANKING_WEB_NGINX_IMAGE=nginx:1.28-alpine
