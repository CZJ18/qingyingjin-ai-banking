# Generate local credentials with Setup-Local.ps1. Keep .env and .env.local private.
# Passwords are independent 32-byte random hexadecimal values. URL-encode replacements.
BANKING_AGENT_IMAGE=qingrongjin-banking-agent-service:p5
BANKING_AGENT_POSTGRES_ADMIN_PASSWORD=replace-with-independent-admin-password
BANKING_AGENT_POSTGRES_APP_PASSWORD=replace-with-independent-runtime-password
BANKING_AGENT_REDIS_PASSWORD=replace-with-independent-redis-password
BANKING_AGENT_MIGRATION_URL=postgresql://postgres:${BANKING_AGENT_POSTGRES_ADMIN_PASSWORD}@banking-agent-postgres:5432/qingrongjin_agent
BANKING_AGENT_DATABASE_URL=postgresql://banking_agent_app:${BANKING_AGENT_POSTGRES_APP_PASSWORD}@banking-agent-postgres:5432/qingrongjin_agent
BANKING_AGENT_REDIS_URL=redis://:${BANKING_AGENT_REDIS_PASSWORD}@banking-agent-redis:6379/0
BANKING_AGENT_BANKING_URL=http://banking-service:8090
# Run Setup-P5.ps1 to generate this independent bridge credential and synchronize
# it with Banking's BANKING_LANGGRAPH_SERVICE_TOKEN. Never use a JWT secret or PAT.
BANKING_AGENT_SERVICE_KEY=CHANGE_ME_INDEPENDENT_SERVICE_KEY_AT_LEAST_32_BYTES
