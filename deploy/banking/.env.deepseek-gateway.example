# PrepareGateway creates a private copy; supplier API key must never be here.
# Explicit development HTTP origin on the attached local Docker network only.
BANKING_ENVIRONMENT=development
DEEPSEEK_GATEWAY_BASE_URL=http://banking-model-gateway:8092/v1
DEEPSEEK_GATEWAY_ALLOWED_ORIGIN=http://banking-model-gateway:8092
# Host-side verification of the same gateway credential through loopback mapping.
DEEPSEEK_GATEWAY_VERIFY_BASE_URL=http://127.0.0.1:18160/v1
DEEPSEEK_GATEWAY_TOKEN=
DEEPSEEK_MODEL=
DEEPSEEK_MAX_TOKENS=
DEEPSEEK_WORKFLOW_TIMEOUT_MS=120000
