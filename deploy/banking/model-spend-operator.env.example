# Dedicated offline operator role; not mounted into model gateway or Banking.
BANKING_ENVIRONMENT=production
BANKING_DATABASE_DRIVER=postgres
BANKING_POSTGRES_HOST=
BANKING_POSTGRES_PORT=5432
BANKING_POSTGRES_DATABASE=
BANKING_POSTGRES_USER=
BANKING_POSTGRES_PASSWORD=
BANKING_POSTGRES_SSLMODE=verify-full
