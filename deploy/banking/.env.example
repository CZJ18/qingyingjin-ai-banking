# Copy to deploy/banking/.env, then replace every CHANGE_ME secret.
# Never copy real banking credentials here. This service only supports simulation.
BANKING_IMAGE=qingyingjin-banking-service:module13
BANKING_HTTP_ADDR=0.0.0.0:8090
BANKING_LOG_LEVEL=info
BANKING_CHECK_TIMEOUT=2s
BANKING_MYSQL_HOST=banking-mysql
BANKING_MYSQL_PORT=3306
BANKING_MYSQL_DATABASE=qingyingjin
BANKING_MYSQL_USER=banking
BANKING_MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
BANKING_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
BANKING_MYSQL_TLS=false
BANKING_REDIS_ADDR=banking-redis:6379
BANKING_REDIS_USERNAME=
BANKING_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
BANKING_REDIS_DB=0
BANKING_USER_JWT_SECRET=CHANGE_ME_USER_SECRET_AT_LEAST_32_BYTES
# Optional P5 bridge credential. Setup-P5.ps1 generates a separate secret and
# synchronizes BANKING_AGENT_SERVICE_KEY; a user/agent JWT is also required.
BANKING_LANGGRAPH_SERVICE_TOKEN=
BANKING_JWT_ISSUER=qingyingjin
BANKING_JWT_AUDIENCE=banking-service
BANKING_TOOL_TOKEN=CHANGE_ME_TOOL_SECRET_AT_LEAST_32_BYTES
BANKING_TOOL_USER_ID=42
# Operator-verified mapping; blank means no Coze user binding is claimed.
BANKING_TOOL_COZE_USER_ID=
# Optional, must be configured together. Coze PAT belongs only to Banking->Coze calls.
BANKING_COZE_BASE_URL=
BANKING_COZE_PAT=
BANKING_COZE_TIMEOUT=30s

# Published parser workflow. Leave empty until Coze is available.
BANKING_GOAL_WORKFLOW_ID=

# Published Billing query router workflow; optional.
BANKING_BILLING_WORKFLOW_ID=

# Module7 protected API executor and published Coze workflow IDs
BANKING_ORCHESTRATOR_API_BASE_URL=http://127.0.0.1:8090
BANKING_SUPERVISOR_WORKFLOW_ID=
BANKING_BILLING_AGENT_WORKFLOW_ID=
BANKING_SUBSCRIPTION_AGENT_WORKFLOW_ID=
BANKING_SAVINGS_AGENT_WORKFLOW_ID=

# P2 references; leave empty until these NEW workflows are actually published.
COZE_LIFESTYLE_GOAL_WORKFLOW_ID=
BANKING_LIFESTYLE_AGENT_WORKFLOW_ID=
